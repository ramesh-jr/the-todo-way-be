# Database
DATABASE_URL=postgresql+asyncpg://todouser:todopass@localhost:5432/the_todo_way

# Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# App
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Account recovery
RECOVERY_CODE_TTL_MINUTES=30

# Encryption key for OAuth tokens at rest (Fernet, urlsafe base64 of 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Web Push (VAPID). Generate a key pair, e.g. via the web-push CLI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Calendar OAuth (satellites)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
